<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory="storage/framework/testing/phpunit-cache"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
            <!-- Gap5.F3 — Mecanismo 1 orphan files moved to _legacy per
                 atlas-dev-forge-escalation-consolidation-plan.md. Tests
                 retained for historical reference but excluded from suite. -->
            <exclude>tests/Unit/Ai/Programming/AtlasDev/Escalation/_legacy</exclude>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <ini name="memory_limit" value="4096M"/>
        <!-- force="true": se o launcher exportou APP_ENV=local (`.env` do host), o
             PHPUnit deve vencer e forçar testing, senão o Laravel carrega `.env`
             (DB_CONNECTION=pgsql) em vez de `.env.testing` (sqlite :memory:). -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="ATLAS_TOKEN" value="testing-atlas-token-with-enough-length"/>
        <env name="ATLAS_TASK_SERVING_QUEUE_DISK" value="local"/>
        <!-- piso anti-vazamento: teste NUNCA escreve no storage vivo do Rivals -->
        <env name="ATLAS_RIVALS2_STORAGE" value="storage/testing/rivals" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="ATLAS_AI_PROVIDER_PROJECTION_LEAN_NESTED" value="false"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- force="true": um launcher que exporta DB_* (ex.: `set -a; source .env`)
             NÃO pode apontar a suite para o Postgres vivo. Em 02/07/2026 uma suite
             detached com env vazado rodou migration->down()/RefreshDatabase contra
             o DB de produção e derrubou o registro canônico de memória. -->
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- AP-811: code graph is activated in dev/prod .env, but tests stay
             deterministic with it OFF (per-test config()->set turns it on where needed). -->
        <env name="ATLAS_CODE_GRAPH_REAL_EDGES" value="false"/>
        <!-- AOBG workspace API activation mutates real workspace provider files.
             Keep it off in tests unless a test explicitly enables and stubs it. -->
        <env name="ATLAS_AOBG_WORKSPACE_API_AUTO_ACTIVATE" value="false"/>
        <!-- AP-813: compression layer is activated in dev/prod .env, but tests stay
             deterministic with it OFF (per-test config()->set turns it on where needed). -->
        <env name="ATLAS_COMPRESSION_LAYER_ENABLED" value="false"/>
        <!-- AUCRI local semantic scoring is ON in dev/prod (real cosine scores via
             the local semantic_rag runtime when its venv exists), but tests stay
             deterministic/hermetic with it OFF — the venv exists on this machine,
             so without this the AUCRI feature suite would spawn real Python.
             Per-test config()->set + a bound fake runtime turn it on where needed. -->
        <env name="ATLAS_AUCRI_LOCAL_SEMANTIC_SCORING" value="false"/>
        <!-- Learning-transfer admission ledger: tests exercising the report→learning
             bridge default-construct the orchestrator, which appended fixture lessons
             (pkt-A / evidence://) to the REAL storage/atlas/learning-transfer/admission.jsonl.
             Pin the default path to /tmp so fixture lessons can never poison a ledger a
             future reader will trust. Tests that assert ledger content inject their own path. -->
        <env name="ATLAS_LEARNING_TRANSFER_ADMISSION_LEDGER_PATH" value="/tmp/atlas-testing-learning-transfer-admission.jsonl"/>
        <!-- Loop obra planning is armed in the dev/prod .env (live campaign), but with it
             ON every Feature test that reaches executeAndProve() invokes the REAL default
             provider (hermes) — 60-600s per call, flaky, and it spends. Tests stay on the
             deterministic buildPlan lane; per-test config()->set turns planning on where
             the planning machinery itself is under test (with the provider seam stubbed). -->
        <env name="ATLAS_LOOP_PLANNING_ENABLED" value="false"/>
        <!-- V1 strict census is armed in the live .env; tests assert the documented
             default (named-based census) and opt in per-test for strict mode. -->
        <env name="ATLAS_LOOP_SYMBOL_BRANCH_CENSUS_ENABLED" value="false"/>
        <!-- The live .env routes Atlas Dev to hermes (MiniMax-impl doctrine). The Dev
             Feature suites were written against the documented claude_cli default and
             stub that lane (FakeClaudeCliGateway); with hermes they silently make LIVE
             ~50s provider calls per run. Tests pin the documented default; hermes-lane
             tests opt in per-test. -->
        <env name="ATLAS_DEV_DEFAULT_PROVIDER" value="claude_cli"/>
        <!-- Campaign flag armed in the live .env; suites assert the documented default
             (per-lane certification) and opt in per-test where universal cert is under test. -->
        <env name="ATLAS_LOOP_UNIVERSAL_CERTIFICATION" value="false"/>
        <env name="ATLAS_LOOP_MULTI_FILE_REFACTOR_VIA_NORMAL_LANE" value="false"/>
        <env name="ATLAS_LOOP_MULTI_FILE_HUB_FIRST_ENABLED" value="false"/>
        <!-- T1.2: capture quality gate is ENFORCE in dev/prod .env, but tests stay
             deterministic on the historical default (per-test config()->set turns
             enforce on where the gate itself is under test). -->
        <env name="ATLAS_CAPTURE_QUALITY_MODE" value="observe"/>
        <!-- AP-819 F1: failure auto feed is activated in dev/prod .env; tests opt in
             explicitly (config set or force flag) so suites never harvest implicitly. -->
        <env name="ATLAS_FAILURE_AUTO_FEED_ENABLED" value="false"/>
        <!-- AP-819 autopilot is activated in dev/prod .env; tests opt in explicitly
             via config set so suites never approve/apply/reverse implicitly. -->
        <env name="ATLAS_HARNESS_AUTOPILOT_ENABLED" value="false"/>
        <!-- G2: the cost guard soft warn is activated in dev/prod .env (3.0 units),
             but tests stay deterministic on the historical 0/0 default so provider
             identity assertions are unaffected (guard tests set config explicitly). -->
        <env name="ATLAS_AI_CALL_COST_GUARD_SOFT_UNITS" value="0"/>
        <env name="ATLAS_AI_CALL_COST_GUARD_HARD_UNITS" value="0"/>
        <!-- L6-14: the per-change-class trust ladder is ENABLED in dev/prod .env, and the
             Loop auto-merge pipeline now feeds it from real merges. Pin the canonical
             ledger to an isolated testing path so real-merge tests can NEVER pollute the
             production ledger (storage/atlas/governance/change_class_trust.jsonl). Tests
             that assert on the ledger override this with their own temp file. -->
        <env name="ATLAS_TRUST_LADDER_LOG_PATH" value="storage/framework/testing/atlas-trust-ladder-testenv.jsonl"/>
        <!-- Hermes governed skill provisioning is activated in the dev .env
             (atlas_adapter). Pin tests to the historical 'off' default so the
             invocation-args contract stays deterministic; the provisioning
             tests opt in via config set explicitly. -->
        <env name="ATLAS_AI_HERMES_SKILL_PROVISION_POLICY" value="off"/>
        <env name="ATLAS_AI_HERMES_MEMORY_POLICY" value="off"/>
        <env name="ATLAS_AI_HERMES_PROCEDURE_POLICY" value="off"/>
        <env name="ATLAS_AI_HERMES_SCHEDULE_POLICY" value="off"/>
        <!-- The semantic architecture judge calls the LOCAL hermes one-shot (~30-120s).
             Suites stay hermetic + fast; judge tests inject a fake runner explicitly. -->
        <env name="ATLAS_REFACTOR_SEMANTIC_JUDGE" value="off"/>
    </php>
</phpunit>
