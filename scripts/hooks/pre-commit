#!/usr/bin/env bash
#
# Atlas C4 — auto-cura (auto-heal) commit hook. NON-BLOCKING by design.
#
# On `git commit`, if a STAGED canonical doc over-claims (implementation_state
# partial/verified whose evidence does not resolve), this auto-DOWNGRADES it to
# the honest computed state and re-stages it, so the commit proceeds HONEST.
#
#   * It NEVER blocks the commit. The heal is downgrade-only (it can only make a
#     claim more conservative — never introduce a lie), the underlying command
#     always exits 0, and any error/timeout still lets the commit through.
#   * This is NOT the BLOCKING ADRS gate. That one lives at
#     scripts/hooks-optional/pre-commit-adrs-blocking (install it deliberately).
#   * Turn OFF:  rm .git/hooks/pre-commit
#   * Last run:  git rev-parse --git-path atlas-autoheal-last.log
#
set +e

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -n "$ROOT" ] || exit 0

PHP_BIN="/opt/homebrew/bin/php"
[ -x "$PHP_BIN" ] || PHP_BIN="php"

LOG="$(git rev-parse --git-path atlas-autoheal-last.log 2>/dev/null)"
[ -n "$LOG" ] || LOG="/dev/null"

"$PHP_BIN" "$ROOT/artisan" atlas:documentation-reality-auto-heal --staged --apply \
    > "$LOG" 2>&1

exit 0
