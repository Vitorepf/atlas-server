#!/usr/bin/env bash
#
# Atlas — secret-leak pre-push gate. BLOCKING by design (fail-closed).
#
# Refuses to push any NEW commit whose tree contains a `.env*` file (except
# .env.example / .env.testing). This is the structural fix for the
# .env.bak leak class: no matter which automation runs `git push`, a
# commit carrying env secrets never leaves the machine.
#
#   * Install:  cp scripts/git-hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#   * Bypass (operator only, deliberate): git push --no-verify
#
set -u

zero=0000000000000000000000000000000000000000
blocked=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue  # branch deletion

    if [ "$remote_sha" = "$zero" ]; then
        # New remote branch: only commits not already on any remote ref.
        commits=$(git rev-list "$local_sha" --not --remotes 2>/dev/null)
    else
        commits=$(git rev-list "$remote_sha..$local_sha" 2>/dev/null)
    fi
    [ -n "$commits" ] || continue

    for c in $commits; do
        bad=$(git ls-tree -r --name-only "$c" \
            | grep -E '(^|/)\.env(\.|$)' \
            | grep -vE '(^|/)\.env\.(example|testing)$' || true)
        if [ -n "$bad" ]; then
            echo "PUSH BLOCKED — commit $c contains .env secrets:" >&2
            echo "$bad" | sed 's/^/  /' >&2
            blocked=1
        fi
    done
done

if [ "$blocked" = "1" ]; then
    echo "Purge the file(s) from these commits before pushing (or operator: --no-verify)." >&2
    exit 1
fi

exit 0
