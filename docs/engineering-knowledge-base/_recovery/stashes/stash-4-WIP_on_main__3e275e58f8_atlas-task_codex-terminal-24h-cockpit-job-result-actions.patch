+            }
+            if ($scopeType !== null) {
+                $qb->where('scope_type', $scopeType);
+            }
+
+            $results = $qb->get(['id', 'memory_type', 'scope_type', 'scope_id', 'title', 'status', 'privacy_class', 'recorded_at'])
+                ->filter(fn ($entry): bool => (bool) $this->privacy->providerDecision($entry)['allowed'])
+                ->map(fn ($entry): array => [
+                    'id' => (string) $entry->id,
+                    'memory_type' => (string) $entry->memory_type,
+                    'scope_type' => (string) $entry->scope_type,
+                    'scope_id' => $entry->scope_id,
+                    'title' => $this->privacy->providerTitle($entry),
+                    'status' => (string) $entry->status,
+                    'recorded_at' => $entry->recorded_at?->toJSON(),
