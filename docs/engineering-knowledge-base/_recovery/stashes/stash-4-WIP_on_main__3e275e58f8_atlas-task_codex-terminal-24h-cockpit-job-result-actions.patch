+    /**
+     * GAP-RE-RAG-08: bounded freshness linker.
+     *
+     * Upserts a self-referencing `freshness_tick` edge on each node updated
+     * within the current sync window (default: last 2 × freshness_stale_hours).
+     * This lets downstream consumers determine AGRN freshness by edge presence
+     * (edge = synced recently) rather than raw node updated_at timestamps.
+     *
+     * Bounded: reads at most 500 recently-updated nodes, never touches external
+     * infra, never writes provider-unsafe data. Idempotent — edges upsert on
+     * (from, to, kind). Fail-open: returns 0 on any error.
+     */
+    private function linkNodeFreshness(): int
+    {
+        if (! $this->tableExists('atlas_aurg_nodes') || ! $this->tableExists('atlas_aurg_edges')) {
+            return 0;
+        }
+
+        try {
+            $windowHours = max(1, (int) config('atlas.aurg.freshness_stale_hours', 48)) * 2;
+            $since = now()->subHours($windowHours)->toDateTimeString();
+
+            $recentIds = AtlasAurgNode::query()
+                ->where('updated_at', '>=', $since)
+                ->orderByDesc('updated_at')
+                ->limit(500)
+                ->pluck('id')
+                ->all();
+
+            if ($recentIds === []) {
+                return 0;
+            }
+
+            $edges = [];
+            foreach ($recentIds as $nodeId) {
+                $edges[] = $this->edge(
+                    from: $nodeId,
+                    to: $nodeId,
+                    kind: 'freshness_tick',
+                    source: 'linker_freshness',
+                    confidence: self::CONFIDENCE_EXACT,
+                    meta: ['synced_at' => now()->toIso8601String()],
+                );
+            }
+
+            return $this->upsertEdges($edges);
+        } catch (Throwable) {
+            return 0;
+        }
+    }
+
