+    /**
+     * OB-03 Tier 2 — Context: chronological entries around an anchor ID (~400 tok).
+     * Returns entries before and after the anchor by recorded_at, plus direct relations.
+     * Requires anchor_id. Fail-open.
+     *
+     * @param  array<string,mixed>  $arguments
+     * @return array<string,mixed>
+     */
+    private function memorySearchTimeline(array $arguments): array
+    {
+        $anchorId = $this->string($arguments['anchor_id'] ?? null);
+        if ($anchorId === null) {
+            return ['ok' => false, 'tool' => 'atlas_memory_timeline', 'error' => 'anchor_id_required'];
+        }
+
+        try {
+            if (! Schema::hasTable('atlas_memory_entries')) {
+                return ['ok' => true, 'tool' => 'atlas_memory_timeline', 'anchor' => null, 'before' => [], 'after' => [], 'note' => 'table_missing'];
+            }
+
+            $anchor = AtlasMemoryEntry::find($anchorId);
+            if ($anchor === null) {
+                return ['ok' => false, 'tool' => 'atlas_memory_timeline', 'error' => 'anchor_not_found'];
+            }
+
+            $privacyDecision = $this->privacy->providerDecision($anchor);
+            if (! (bool) $privacyDecision['allowed']) {
+                return ['ok' => false, 'tool' => 'atlas_memory_timeline', 'error' => 'not_provider_safe'];
+            }
+
+            $window = min(10, max(1, (int) ($arguments['window'] ?? 3)));
+            $anchorTs = $anchor->recorded_at;
+
+            $before = AtlasMemoryEntry::query()->active()
+                ->where('recorded_at', '<', $anchorTs)
+                ->where('scope_type', $anchor->scope_type)
+                ->orderByDesc('recorded_at')
+                ->limit($window)
+                ->get(['id', 'memory_type', 'scope_type', 'title', 'recorded_at'])
+                ->filter(fn ($e): bool => (bool) $this->privacy->providerDecision($e)['allowed'])
+                ->map(fn ($e): array => ['id' => (string) $e->id, 'title' => $this->privacy->providerTitle($e), 'recorded_at' => $e->recorded_at?->toJSON()])
+                ->values()->all();
+
+            $after = AtlasMemoryEntry::query()->active()
+                ->where('recorded_at', '>', $anchorTs)
+                ->where('scope_type', $anchor->scope_type)
+                ->orderBy('recorded_at')
+                ->limit($window)
+                ->get(['id', 'memory_type', 'scope_type', 'title', 'recorded_at'])
+                ->filter(fn ($e): bool => (bool) $this->privacy->providerDecision($e)['allowed'])
+                ->map(fn ($e): array => ['id' => (string) $e->id, 'title' => $this->privacy->providerTitle($e), 'recorded_at' => $e->recorded_at?->toJSON()])
+                ->values()->all();
+
+            $result = [
+                'ok' => true,
+                'tool' => 'atlas_memory_timeline',
+                'tier' => 2,
+                'anchor' => [
+                    'id' => (string) $anchor->id,
+                    'memory_type' => (string) $anchor->memory_type,
+                    'scope_type' => (string) $anchor->scope_type,
+                    'title' => $this->privacy->providerTitle($anchor),
+                    'recorded_at' => $anchorTs?->toJSON(),
+                ],
+                'before' => $before,
+                'after' => $after,
+            ];
+
+            if ((bool) ($arguments['include_relations'] ?? false)) {
+                $result['relations'] = $anchor->outgoingRelations()->get()->map(fn ($r) => [
+                    'target_id' => (string) $r->target_memory_entry_id,
+                    'relation_type' => $r->relation_type,
+                ])->toArray();
+            }
+
+            return $result;
+        } catch (Throwable) {
+            return ['ok' => true, 'tool' => 'atlas_memory_timeline', 'anchor' => null, 'before' => [], 'after' => [], 'note' => 'fail_open'];
+        }
+    }
+
+    /**
+     * OB-03 Tier 3 — Detail: full payload for a batch of IDs (~800 tok/item).
+     * Enforces privacy gate per entry. Batch max 10. Fail-open.
+     *
+     * @param  array<string,mixed>  $arguments
+     * @return array<string,mixed>
+     */
+    private function memoryGetFull(array $arguments): array
+    {
+        $ids = (array) ($arguments['ids'] ?? []);
+        $ids = array_filter(array_map(fn ($id) => $this->string($id), $ids), fn ($id) => $id !== null);
+        $ids = array_values(array_slice($ids, 0, 10));
+
+        if ($ids === []) {
+            return ['ok' => false, 'tool' => 'atlas_memory_get_full', 'error' => 'ids_required'];
+        }
+
+        try {
+            if (! Schema::hasTable('atlas_memory_entries')) {
+                return ['ok' => true, 'tool' => 'atlas_memory_get_full', 'entries' => [], 'note' => 'table_missing'];
+            }
+
+            $includeRelations = (bool) ($arguments['include_relations'] ?? false);
+            $entries = AtlasMemoryEntry::query()->whereIn('id', $ids)->get();
+
+            $results = [];
+            foreach ($entries as $entry) {
+                $privacyDecision = $this->privacy->providerDecision($entry);
+                if (! (bool) $privacyDecision['allowed']) {
+                    $results[] = ['id' => (string) $entry->id, 'ok' => false, 'error' => 'not_provider_safe'];
+
+                    continue;
+                }
+
+                $payload = [
+                    'id' => (string) $entry->id,
+                    'memory_type' => (string) $entry->memory_type,
+                    'scope_type' => (string) $entry->scope_type,
+                    'scope_id' => $entry->scope_id,
+                    'title' => $this->privacy->providerTitle($entry),
+                    'body' => $this->privacy->providerBody($entry),
+                    'summary' => $this->privacy->providerSummary($entry),
+                    'tags' => $entry->tags ?? [],
+                    'status' => (string) $entry->status,
+                    'privacy_class' => (string) $entry->privacy_class,
+                    'recorded_at' => $entry->recorded_at?->toJSON(),
+                ];
+
+                if ($includeRelations) {
+                    $payload['relations'] = $entry->outgoingRelations()->get()->map(fn ($r) => [
+                        'target_id' => (string) $r->target_memory_entry_id,
+                        'relation_type' => $r->relation_type,
+                        'status' => $r->status,
+                    ])->toArray();
+                }
+
+                $results[] = array_merge(['ok' => true], $payload);
+            }
+
+            return [
+                'ok' => true,
+                'tool' => 'atlas_memory_get_full',
+                'tier' => 3,
+                'count' => count($results),
+                'entries' => $results,
+            ];
+        } catch (Throwable) {
+            return ['ok' => true, 'tool' => 'atlas_memory_get_full', 'entries' => [], 'note' => 'fail_open'];
+        }
+    }
