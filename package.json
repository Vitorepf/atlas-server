{
  "name": "atlas-server",
  "type": "module",
  "version": "1.0.0",
  "description": "Atlas server - Backend Fastify + PostgreSQL + Docker",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:reset": "docker compose down -v && docker compose up -d db"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^9.0.0",
    "pg": "^8.13.0",
    "zod": "^3.24.0",
    "gray-matter": "^4.0.3",
    "chokidar": "^4.0.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0"
  },
  "engines": {
    "node": ">=20"
  }
}
