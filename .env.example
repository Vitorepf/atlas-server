APP_NAME=Atlas
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3737
APP_VERSION=1.0.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=atlas
DB_USERNAME=atlas
DB_PASSWORD=atlas_local_2026

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=atlas
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

ATLAS_TOKEN=replace-with-a-long-random-token
ATLAS_STORAGE_PATH=/var/atlas/storage
ATLAS_MAX_UPLOAD_BYTES=104857600
ATLAS_VAULT_PATH=/Users/vitorepf/Develop/atlas/AtlasVault
ATLAS_SEMANTIC_EMBEDDING_DIMENSIONS=1536
ATLAS_SEMANTIC_MAX_EMBEDDING_CHARS=12000
ATLAS_SEMANTIC_ACTIVATION_DAILY_LIMIT=2
ATLAS_SEMANTIC_CURATION_MIN_CONTENT_CHARS=160

TRANSCRIPTION_ENABLED=true
WHISPER_BIN_PATH=/usr/local/bin/whisper-cli
WHISPER_MODEL_PATH=/opt/whisper-models/ggml-base.bin
FFMPEG_BIN_PATH=/usr/bin/ffmpeg
WHISPER_LANGUAGE=pt
WHISPER_ENGINE=whisper-cpp-base

RIZE_API_KEY=
RIZE_WEBHOOK_SECRET=
RIZE_GRAPHQL_ENDPOINT=https://api.rize.io/api/v1/graphql
RIZE_TIMEZONE=America/Sao_Paulo
RIZE_HTTP_TIMEOUT=30
RIZE_SYNC_ENABLED=true
RIZE_SYNC_LOOKBACK_DAYS=2
RIZE_SYNC_PAGE_SIZE=100
RIZE_SESSIONS_QUERY_PATH=
RIZE_SESSIONS_ROOT_PATH=sessions.nodes
RIZE_SESSIONS_PAGE_INFO_PATH=sessions.pageInfo
