# Cursor SDK provider for Atlas.
# Create the key in Cursor Dashboard -> Integrations -> User API Keys.
# Future/API path only: keep disabled while the strategy is Cursor account login via cursor_cli.
ATLAS_CURSOR_SDK_ENABLED=false
CURSOR_API_KEY=
ATLAS_CURSOR_SDK_RUNTIME_MODE=local
ATLAS_CURSOR_SDK_BILLING_MODE=cursor_account_usage_bucket
ATLAS_CURSOR_SDK_QUOTA_BUCKET=cursor_account_default

# Cursor CLI provider for Atlas.
# Uses local Cursor Agent CLI login/account usage. Install with Cursor CLI and run: cursor-agent login
ATLAS_CURSOR_CLI_ENABLED=false
ATLAS_CURSOR_CLI_BINARY=cursor-agent
ATLAS_CURSOR_CLI_AUTH_MODE=local_login
ATLAS_CURSOR_CLI_MODEL=composer-2.5-fast
ATLAS_CURSOR_CLI_COMPOSER_2_5_MODEL=composer-2.5
ATLAS_CURSOR_CLI_OUTPUT_FORMAT=stream-json
# Governed Rivals/Forge execution forbids Cursor CLI --force because it can
# weaken command approval semantics. Keep false; true becomes a blocker.
ATLAS_CURSOR_CLI_FORCE=false
ATLAS_CURSOR_CLI_BILLING_MODE=cursor_account_cli_pool
ATLAS_CURSOR_CLI_QUOTA_BUCKET=cursor_account_composer_pool

# Forge Rivals worktree setup preflight.
# Blocks before git worktree add when the runs volume is too full for isolated arms.
ATLAS_FORGE_RIVALS_MIN_FREE_BYTES_BEFORE_WORKTREE_ADD=1073741824
