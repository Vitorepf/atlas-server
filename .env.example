TRANSCRIPTION_ENABLED=true
# Paths abaixo variam por ambiente:
#   macOS Apple Silicon (Homebrew): /opt/homebrew/bin/whisper-cli, /opt/homebrew/bin/ffmpeg
#   macOS Intel (Homebrew):         /usr/local/bin/whisper-cli,    /usr/local/bin/ffmpeg
#   Linux (apt/Docker):             /usr/local/bin/whisper-cli,    /usr/bin/ffmpeg
# O container Docker do Atlas usa os valores em docker-compose.yml e ignora este .env.
WHISPER_BIN_PATH=/usr/local/bin/whisper-cli
# Modelo é fixado em código (config/atlas.php) como ggml-large-v3-turbo.bin (~1.6GB, multilingue, top-tier).
# Download: https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo.bin
# Aqui você só aponta o diretório onde o arquivo está.
WHISPER_MODELS_DIR=/opt/whisper-models
FFMPEG_BIN_PATH=/usr/bin/ffmpeg
WHISPER_LANGUAGE=pt
WHISPER_TIMEOUT_SECONDS=3600
WHISPER_NORMALIZE_TIMEOUT_SECONDS=300

