#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  TARGET="$(readlink "$SOURCE")"
  case "$TARGET" in
    /*) SOURCE="$TARGET" ;;
    *) SOURCE="$SOURCE_DIR/$TARGET" ;;
  esac
done

ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
CALLER_PWD="${PWD}"
cd "$ROOT"

ATLAS_MIN_PHP_VERSION="${ATLAS_MIN_PHP_VERSION:-8.4.0}"

php_candidate_path() {
  local candidate="$1"
  if [ -x "$candidate" ]; then
    printf '%s' "$candidate"
    return 0
  fi

  command -v "$candidate" 2>/dev/null || true
}

php_satisfies_minimum() {
  local candidate resolved
  candidate="$1"
  resolved="$(php_candidate_path "$candidate")"
  if [ -z "$resolved" ]; then
    return 1
  fi

  "$resolved" -r 'exit(version_compare(PHP_VERSION, $argv[1], ">=") ? 0 : 1);' "$ATLAS_MIN_PHP_VERSION" >/dev/null 2>&1
}

resolve_php_bin() {
  local candidate resolved

  if [ -n "${ATLAS_PHP_BIN:-}" ]; then
    if php_satisfies_minimum "$ATLAS_PHP_BIN"; then
      php_candidate_path "$ATLAS_PHP_BIN"
      return 0
    fi

    printf 'Atlas CLI requires PHP >= %s, but ATLAS_PHP_BIN is not compatible: %s\n' "$ATLAS_MIN_PHP_VERSION" "$ATLAS_PHP_BIN" >&2
    return 1
  fi

  for candidate in \
    /opt/homebrew/bin/php \
    /opt/homebrew/opt/php/bin/php \
    /opt/homebrew/opt/php@8.5/bin/php \
    /opt/homebrew/opt/php@8.4/bin/php \
    /usr/local/bin/php \
    /usr/local/opt/php/bin/php \
    /usr/local/opt/php@8.5/bin/php \
    /usr/local/opt/php@8.4/bin/php \
    php
  do
    if php_satisfies_minimum "$candidate"; then
      php_candidate_path "$candidate"
      return 0
    fi
  done

  resolved="$(command -v php 2>/dev/null || true)"
  if [ -n "$resolved" ]; then
    printf 'Atlas CLI requires PHP >= %s, but your shell is using: %s\n' "$ATLAS_MIN_PHP_VERSION" "$("$resolved" -v | head -n 1)" >&2
  else
    printf 'Atlas CLI requires PHP >= %s, but no php binary was found.\n' "$ATLAS_MIN_PHP_VERSION" >&2
  fi
  printf 'Install/upgrade with Homebrew or set ATLAS_PHP_BIN, for example:\n' >&2
  printf '  brew install php\n' >&2
  printf '  export ATLAS_PHP_BIN=/opt/homebrew/bin/php\n' >&2
  return 1
}

PHP_BIN="$(resolve_php_bin)"

join_input() {
  local IFS=' '
  printf '%s' "$*"
}

has_workspace_arg() {
  for arg in "$@"; do
    case "$arg" in
      --workspace|--workspace=*)
        return 0
        ;;
    esac
  done

  return 1
}

exec_artisan_with_workspace() {
  local artisan_command="$1"
  shift || true

  if has_workspace_arg "$@"; then
    exec "$PHP_BIN" artisan "$artisan_command" "$@"
  fi

  exec "$PHP_BIN" artisan "$artisan_command" "$@" --workspace="$CALLER_PWD"
}

exec_chat_with_workspace() {
  if has_workspace_arg "$@"; then
    exec "$PHP_BIN" artisan atlas:ai:chat "$@"
  fi

  exec "$PHP_BIN" artisan atlas:ai:chat "$@" --workspace="$CALLER_PWD"
}

exec_chat_prompt_with_workspace() {
  local -a fixed_args=()
  local -a pass_args=()
  local -a prompt_parts=()
  local -a final_args=()

  while [ "$#" -gt 0 ] && [ "${1:-}" != "--" ]; do
    fixed_args+=("$1")
    shift || true
  done

  if [ "${1:-}" = "--" ]; then
    shift || true
  fi

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --image|--ai|--provider|--model|--agent|--thread|--workspace|--mode|--permission|--timeout|--dev-plan|--skill)
        pass_args+=("$1")
        shift || true
        if [ "$#" -gt 0 ]; then
          pass_args+=("$1")
        fi
        ;;
      --image=*|--ai=*|--provider=*|--model=*|--agent=*|--thread=*|--workspace=*|--mode=*|--permission=*|--timeout=*|--dev-plan=*|--skill=*|--clipboard-image|--no-auto-image|--new-thread|--resume-latest|--allow-write|--dangerously-allow-all|--allow-unsandboxed|--claude-only|--single-provider|--no-decide|--fallback-disabled|--compact|--no-intent|--json|--stream|--no-run)
        pass_args+=("$1")
        ;;
      *)
        prompt_parts+=("$1")
        ;;
    esac
    shift || true
  done

  if [ "${#prompt_parts[@]}" -gt 0 ]; then
    final_args+=("$(join_input "${prompt_parts[@]}")")
  fi
  final_args+=("${fixed_args[@]}" "${pass_args[@]}")

  if has_workspace_arg "${final_args[@]}"; then
    exec "$PHP_BIN" artisan atlas:ai:chat "${final_args[@]}"
  fi

  exec "$PHP_BIN" artisan atlas:ai:chat "${final_args[@]}" --workspace="$CALLER_PWD"
}

normalize_blueprint_version_args() {
  local -a normalized=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --version)
        normalized+=("--blueprint-version")
        ;;
      --version=*)
        normalized+=("--blueprint-version=${1#--version=}")
        ;;
      *)
        normalized+=("$1")
        ;;
    esac
    shift || true
  done
  printf '%s\0' "${normalized[@]}"
}

cmd="${1:-chat}"

case "$cmd" in
  help|-h|--help)
    shift || true
    exec "$PHP_BIN" artisan atlas:cli:help "$@"
    ;;
  completion)
    shift || true
    exec "$PHP_BIN" artisan atlas:cli:completion "$@"
    ;;
  chat)
    shift || true
    exec_chat_with_workspace "$@"
    ;;
  ask)
    shift || true
    exec_chat_prompt_with_workspace --stream --no-skill-prompt -- "$@"
    ;;
  terminal|term|agent)
    shift || true
    # Rust TUI only for interactive empty launch (TTY, no oneshot args).
    # Flags like --json/--stdio/positional prompt always use PHP AAP runtime.
    use_tui=1
    if [ -n "${ATLAS_TERMINAL_FORCE_PHP:-}" ]; then
      use_tui=0
    fi
    if [ ! -t 0 ] || [ ! -t 1 ]; then
      use_tui=0
    fi
    for arg in "$@"; do
      case "$arg" in
        --json|--stdio|--once|--hermes-dry|--help|-h)
          use_tui=0
          ;;
        --timeout|--timeout=*|--provider|--provider=*|--workspace|--workspace=*|--resume|--resume=*|--plan|--yolo|--permission|--permission=*|--profile|--profile=*)
          ;;
        -*)
          ;;
        *)
          # positional prompt => oneshot PHP path
          use_tui=0
          ;;
      esac
    done
    if [ "$use_tui" = 1 ]; then
      for candidate in \
        "${ATLAS_TERM_BIN:-}" \
        "$ROOT/../atlas-terminal/target/release/atlas-term" \
        "$ROOT/../atlas-terminal/target/debug/atlas-term"
      do
        if [ -n "$candidate" ] && [ -x "$candidate" ]; then
          export ATLAS_SERVER_ROOT="$ROOT"
          export ATLAS_PHP_BIN="${ATLAS_PHP_BIN:-$PHP_BIN}"
          exec "$candidate" "$@"
        fi
      done
      if command -v atlas-term >/dev/null 2>&1; then
        export ATLAS_SERVER_ROOT="$ROOT"
        export ATLAS_PHP_BIN="${ATLAS_PHP_BIN:-$PHP_BIN}"
        exec atlas-term "$@"
      fi
    fi
    exec_artisan_with_workspace atlas:terminal "$@"
    ;;
  dev)
    shift || true
    exec_artisan_with_workspace atlas:cli:dev "$@"
    ;;
  forge)
    shift || true
    exec_artisan_with_workspace atlas:cli:dev --forge "$@"
    ;;
  autonomos)
    shift || true
    exec_artisan_with_workspace atlas:self-construction:runtime-daemon claim --json "$@"
    ;;
  fix)
    shift || true
    exec_artisan_with_workspace atlas:cli:fix "$@"
    ;;
  plan)
    shift || true
    exec_chat_prompt_with_workspace --mode=plan --stream --no-skill-prompt -- "$@"
    ;;
  review)
    shift || true
    if [ "${1:-}" = "--deep" ]; then
      shift || true
      exec_artisan_with_workspace atlas:review:deep "$@"
    fi
    exec_chat_prompt_with_workspace --mode=review --stream --no-skill-prompt -- "$@"
    ;;
  compare)
    shift || true
    exec_artisan_with_workspace atlas:cli:compare "$@"
    ;;
  debug)
    shift || true
    exec_chat_prompt_with_workspace --mode=debug --stream --no-skill-prompt -- "$@"
    ;;
  research)
    shift || true
    exec_chat_prompt_with_workspace --mode=research --stream --no-skill-prompt -- "$@"
    ;;
  decide|why)
    shift || true
    exec_artisan_with_workspace atlas:ai:decide "$@"
    ;;
  threads|sessions)
    shift || true
    if has_workspace_arg "$@"; then
      exec "$PHP_BIN" artisan atlas:ai:chat --list-threads "$@"
    fi
    exec "$PHP_BIN" artisan atlas:ai:chat --list-threads "$@" --workspace="$CALLER_PWD"
    ;;
  status|dashboard)
    shift || true
    exec_artisan_with_workspace atlas:cli:dashboard "$@"
    ;;
  tui)
    shift || true
    if [ "${1:-}" = "--classic" ]; then
      shift || true
      if has_workspace_arg "$@"; then
        exec "$PHP_BIN" artisan atlas:cli:dashboard --classic "$@"
      fi
      exec "$PHP_BIN" artisan atlas:cli:dashboard --classic "$@" --workspace="$CALLER_PWD"
    fi
    exec_artisan_with_workspace atlas:cli:tui "$@"
    ;;
  state)
    shift || true
    exec_artisan_with_workspace atlas:cli:state "$@"
    ;;
  steer)
    shift || true
    if has_workspace_arg "$@"; then
      exec "$PHP_BIN" artisan atlas:cli:state pending-steer set "$@"
    fi
    exec "$PHP_BIN" artisan atlas:cli:state pending-steer set "$@" --workspace="$CALLER_PWD"
    ;;
  interrupt|stop|cancel)
    shift || true
    exec_artisan_with_workspace atlas:cli:interrupt "$@"
    ;;
  continue|resume)
    shift || true
    exec_artisan_with_workspace atlas:cli:continue "$@"
    ;;
  compact)
    shift || true
    if has_workspace_arg "$@"; then
      exec "$PHP_BIN" artisan atlas:cli:state compact "$@"
    fi
    exec "$PHP_BIN" artisan atlas:cli:state compact "$@" --workspace="$CALLER_PWD"
    ;;
  handoff|switch)
    shift || true
    if has_workspace_arg "$@"; then
      exec "$PHP_BIN" artisan atlas:cli:state handoff "$@"
    fi
    exec "$PHP_BIN" artisan atlas:cli:state handoff "$@" --workspace="$CALLER_PWD"
    ;;
  checkpoint|checkpoints)
    shift || true
    exec_artisan_with_workspace atlas:cli:checkpoint "$@"
    ;;
  quality|finish)
    shift || true
    exec_artisan_with_workspace atlas:cli:quality "$@"
    ;;
  test)
    shift || true
    if has_workspace_arg "$@"; then
      exec "$PHP_BIN" artisan atlas:cli:quality --run-tests --yes "$@"
    fi
    exec "$PHP_BIN" artisan atlas:cli:quality --run-tests --yes "$@" --workspace="$CALLER_PWD"
    ;;
  rivals|rival)
    # Produto: Rivals (versão 2.0). Comando canônico: atlas:rivals.
    shift || true
    exec_artisan_with_workspace atlas:rivals "$@"
    ;;
  benchmark|bench)
    shift || true
    subcmd="${1:-run}"
    case "$subcmd" in
      seed|init)
        shift || true
        exec_artisan_with_workspace atlas:engineering:benchmark:seed "$@"
        ;;
      calibrate|calibration|cal)
        shift || true
        exec_artisan_with_workspace atlas:engineering:benchmark:calibrate "$@"
        ;;
      report)
        shift || true
        exec_artisan_with_workspace atlas:engineering:benchmark:report "$@"
        ;;
      claude-fair|fair-claude)
        shift || true
        exec_artisan_with_workspace atlas:engineering:benchmark:claude-fair "$@"
        ;;
      rivals|rival)
        shift || true
        exec_artisan_with_workspace atlas:rivals "$@"
        ;;
      run)
        shift || true
        exec_artisan_with_workspace atlas:engineering:benchmark "$@"
        ;;
      replay-manifest|manifest)
        shift || true
        exec "$PHP_BIN" artisan atlas:engineering:benchmark:replay-manifest "$@"
        ;;
      cleanup|docker-cleanup)
        shift || true
        exec "$PHP_BIN" artisan atlas:engineering:docker-cleanup "$@"
        ;;
    esac
    exec_artisan_with_workspace atlas:engineering:benchmark "$@"
    ;;
  engineering|harness)
    shift || true
    subcmd="${1:-run}"
    case "$subcmd" in
      seed|init)
        shift || true
        exec_artisan_with_workspace atlas:engineering:benchmark:seed "$@"
        ;;
      cleanup|docker-cleanup)
        shift || true
        exec "$PHP_BIN" artisan atlas:engineering:docker-cleanup "$@"
        ;;
      quality-scan|quality|scan)
        shift || true
        exec_artisan_with_workspace atlas:engineering:quality-scan "$@"
        ;;
      api-contract|contract|contracts)
        shift || true
        exec_artisan_with_workspace atlas:engineering:api-contract "$@"
        ;;
      security-scan|security|sec)
        shift || true
        exec_artisan_with_workspace atlas:engineering:security-scan "$@"
        ;;
      sbom)
        shift || true
        exec_artisan_with_workspace atlas:engineering:sbom "$@"
        ;;
      knowledge|kb|knowledge-base)
        shift || true
        exec "$PHP_BIN" artisan atlas:engineering:knowledge "$@"
        ;;
      visual-smoke|visual)
        shift || true
        exec_artisan_with_workspace atlas:engineering:visual-smoke "$@"
        ;;
      visual-driver|driver|playwright|visual-runtime)
        shift || true
        exec "$PHP_BIN" artisan atlas:engineering:visual-driver "$@"
        ;;
      visual-baseline|baseline)
        shift || true
        exec_artisan_with_workspace atlas:engineering:visual-baseline "$@"
        ;;
      benchmark|bench)
        shift || true
        nested="${1:-run}"
        case "$nested" in
          seed|init)
            shift || true
            exec_artisan_with_workspace atlas:engineering:benchmark:seed "$@"
            ;;
          calibrate|calibration|cal)
            shift || true
            exec_artisan_with_workspace atlas:engineering:benchmark:calibrate "$@"
            ;;
          report)
            shift || true
            exec_artisan_with_workspace atlas:engineering:benchmark:report "$@"
            ;;
          replay-manifest|manifest)
            shift || true
            exec "$PHP_BIN" artisan atlas:engineering:benchmark:replay-manifest "$@"
            ;;
          cleanup|docker-cleanup)
            shift || true
            exec "$PHP_BIN" artisan atlas:engineering:docker-cleanup "$@"
            ;;
        esac
        exec_artisan_with_workspace atlas:engineering:benchmark "$@"
        ;;
      run|runner)
        shift || true
        exec_artisan_with_workspace atlas:engineering:run "$@"
        ;;
      replay)
        shift || true
        exec_artisan_with_workspace atlas:engineering:replay "$@"
        ;;
      harnessability)
        shift || true
        nested="${1:-calibrate}"
        case "$nested" in
          calibrate|calibration|cal)
            shift || true
            exec "$PHP_BIN" artisan atlas:engineering:harnessability:calibrate "$@"
            ;;
        esac
        exec "$PHP_BIN" artisan atlas:engineering:harnessability:calibrate "$@"
        ;;
      *)
        exec_artisan_with_workspace atlas:engineering:run "$@"
        ;;
    esac
    ;;
  project)
    shift || true
    subcmd="${1:-}"
    case "$subcmd" in
      blueprint)
        shift || true
        action="${1:-prepare}"
        case "$action" in
          prepare)
            shift || true
            exec_artisan_with_workspace atlas:project:blueprint:prepare "$@"
            ;;
          create)
            shift || true
            exec_artisan_with_workspace atlas:project:blueprint:create "$@"
            ;;
          validate)
            shift || true
            mapfile -d '' normalized_args < <(normalize_blueprint_version_args "$@")
            set -- "${normalized_args[@]}"
            exec_artisan_with_workspace atlas:project:blueprint:validate "$@"
            ;;
          freeze)
            shift || true
            mapfile -d '' normalized_args < <(normalize_blueprint_version_args "$@")
            set -- "${normalized_args[@]}"
            exec_artisan_with_workspace atlas:project:blueprint:freeze "$@"
            ;;
        esac
        exec_artisan_with_workspace atlas:project:blueprint:prepare "$@"
        ;;
      tasks)
        shift || true
        action="${1:-generate}"
        case "$action" in
          generate)
            shift || true
            exec_artisan_with_workspace atlas:project:tasks:generate "$@"
            ;;
        esac
        exec_artisan_with_workspace atlas:project:tasks:generate "$@"
        ;;
    esac
    exec_chat_prompt_with_workspace --mode=project --stream --no-skill-prompt -- "$@"
    ;;
  qa)
    shift || true
    exec_artisan_with_workspace atlas:qa "$@"
    ;;
  db)
    shift || true
    subcmd="${1:-review}"
    case "$subcmd" in
      review)
        shift || true
        exec_artisan_with_workspace atlas:db:review "$@"
        ;;
      explain)
        shift || true
        exec_artisan_with_workspace atlas:db:explain "$@"
        ;;
    esac
    exec_artisan_with_workspace atlas:db:review "$@"
    ;;
  tools)
    shift || true
    exec_artisan_with_workspace atlas:tools "$@"
    ;;
  runtime|tool)
    shift || true
    exec_artisan_with_workspace atlas:runtime "$@"
    ;;
  search)
    shift || true
    if has_workspace_arg "$@"; then
      exec "$PHP_BIN" artisan atlas:runtime session.search "$@"
    fi
    exec "$PHP_BIN" artisan atlas:runtime session.search "$@" --workspace="$CALLER_PWD"
    ;;
  trace)
    shift || true
    exec_artisan_with_workspace atlas:cli:trace "$@"
    ;;
  permissions)
    shift || true
    exec_artisan_with_workspace atlas:cli:permissions "$@"
    ;;
  memory:list)
    shift || true
    exec "$PHP_BIN" artisan atlas:memory:list "$@"
    ;;
  memory:add)
    shift || true
    exec "$PHP_BIN" artisan atlas:memory:add "$@"
    ;;
  memory:audit)
    shift || true
    exec "$PHP_BIN" artisan atlas:memory:audit "$@"
    ;;
  memory:promote)
    shift || true
    exec_artisan_with_workspace atlas:cli:memory promote "$@"
    ;;
  memory:govern|memory:governance)
    shift || true
    exec "$PHP_BIN" artisan atlas:memory:govern "$@"
    ;;
  memory:review-queue|memory:queue)
    shift || true
    exec "$PHP_BIN" artisan atlas:memory:review-queue "$@"
    ;;
  memory:relations)
    shift || true
    exec "$PHP_BIN" artisan atlas:memory:relations "$@"
    ;;
  memory:privacy)
    shift || true
    exec "$PHP_BIN" artisan atlas:memory:privacy "$@"
    ;;
  memory:verbatim)
    shift || true
    exec "$PHP_BIN" artisan atlas:memory:verbatim "$@"
    ;;
  memory:projection|memory:project)
    shift || true
    exec_artisan_with_workspace atlas:memory:projection "$@"
    ;;
  memory:recall)
    shift || true
    exec_artisan_with_workspace atlas:memory:recall "$@"
    ;;
  memory:quality|memory:scorecard|memory:health)
    shift || true
    exec_artisan_with_workspace atlas:memory:quality "$@"
    ;;
  memory:maintain|memory:maintenance)
    shift || true
    exec_artisan_with_workspace atlas:memory:maintain "$@"
    ;;
  mcp|open-brain:mcp|brain:mcp)
    shift || true
    exec_artisan_with_workspace atlas:open-brain:mcp "$@"
    ;;
  aobg)
    shift || true
    subcmd="${1:-workspace}"
    case "$subcmd" in
      workspace)
        shift || true
        exec_artisan_with_workspace atlas:aobg:workspace "$@"
        ;;
      status|onboard|activate|activate-all|activate_all|all|map)
        shift || true
        exec_artisan_with_workspace atlas:aobg:workspace "$subcmd" "$@"
        ;;
    esac
    exec_artisan_with_workspace atlas:aobg:workspace "$@"
    ;;
  memory:seed-core|memory:seed)
    shift || true
    exec "$PHP_BIN" artisan atlas:memory:seed-core "$@"
    ;;
  memory)
    shift || true
    subcmd="${1:-review}"
    case "$subcmd" in
      list)
        shift || true
        exec "$PHP_BIN" artisan atlas:memory:list "$@"
        ;;
      seed-core|seed)
        shift || true
        exec "$PHP_BIN" artisan atlas:memory:seed-core "$@"
        ;;
      audit)
        shift || true
        exec "$PHP_BIN" artisan atlas:memory:audit "$@"
        ;;
      govern|governance)
        shift || true
        exec "$PHP_BIN" artisan atlas:memory:govern "$@"
        ;;
      review-queue|queue)
        shift || true
        exec "$PHP_BIN" artisan atlas:memory:review-queue "$@"
        ;;
      curate|curation)
        shift || true
        exec "$PHP_BIN" artisan atlas:memory:curate "$@"
        ;;
      relation|relations)
        shift || true
        exec "$PHP_BIN" artisan atlas:memory:relations "$@"
        ;;
      privacy)
        shift || true
        exec "$PHP_BIN" artisan atlas:memory:privacy "$@"
        ;;
      verbatim)
        shift || true
        exec "$PHP_BIN" artisan atlas:memory:verbatim "$@"
        ;;
      projection|project)
        shift || true
        exec_artisan_with_workspace atlas:memory:projection "$@"
        ;;
      recall)
        shift || true
        exec_artisan_with_workspace atlas:memory:recall "$@"
        ;;
      quality|scorecard|health)
        shift || true
        exec_artisan_with_workspace atlas:memory:quality "$@"
        ;;
      maintain|maintenance)
        shift || true
        exec_artisan_with_workspace atlas:memory:maintain "$@"
        ;;
    esac
    exec_artisan_with_workspace atlas:cli:memory "$@"
    ;;
  open-brain|brain)
    shift || true
    subcmd="${1:-context}"
    case "$subcmd" in
      context|context-pack|export)
        shift || true
        exec_artisan_with_workspace atlas:open-brain:context "$@"
        ;;
      mcp|serve|server)
        shift || true
        exec_artisan_with_workspace atlas:open-brain:mcp "$@"
        ;;
      expand|expand-context|context-expand|expand_context)
        shift || true
        exec_artisan_with_workspace atlas:open-brain:expand-context "$@"
        ;;
      workspace)
        shift || true
        exec_artisan_with_workspace atlas:aobg:workspace "$@"
        ;;
    esac
    exec_artisan_with_workspace atlas:open-brain:context "$@"
    ;;
  mobile)
    shift || true
    exec "$PHP_BIN" artisan atlas:cli:mobile "$@"
    ;;
  inbox)
    shift || true
    exec "$PHP_BIN" artisan atlas:cli:inbox "$@"
    ;;
  insight)
    shift || true
    exec "$PHP_BIN" artisan atlas:insight "$@"
    ;;
  insight-watch|watch-insights)
    shift || true
    exec "$PHP_BIN" artisan atlas:insight:watch "$@"
    ;;
  proposal)
    shift || true
    exec "$PHP_BIN" artisan atlas:proposal "$@"
    ;;
  proposal-scan|proposals-scan|scan-proposals)
    shift || true
    if has_workspace_arg "$@"; then
      exec "$PHP_BIN" artisan atlas:proposal:scan "$@"
    fi
    exec "$PHP_BIN" artisan atlas:proposal:scan "$@" --workspace="$CALLER_PWD"
    ;;
  self-diagnostic|diagnostic)
    shift || true
    exec "$PHP_BIN" artisan atlas:self-diagnostic "$@"
    ;;
  initiatives|initiative)
    shift || true
    if has_workspace_arg "$@"; then
      exec "$PHP_BIN" artisan atlas:initiatives "$@"
    fi
    exec "$PHP_BIN" artisan atlas:initiatives "$@" --workspace="$CALLER_PWD"
    ;;
  schedule|cron)
    shift || true
    if has_workspace_arg "$@"; then
      exec "$PHP_BIN" artisan atlas:cli:schedule "$@"
    fi
    exec "$PHP_BIN" artisan atlas:cli:schedule "$@" --workspace="$CALLER_PWD"
    ;;
  skills)
    shift || true
    exec_artisan_with_workspace atlas:cli:skills "$@"
    ;;
  profile)
    shift || true
    if has_workspace_arg "$@"; then
      exec "$PHP_BIN" artisan atlas:runtime workspace.profile "$@"
    fi
    exec "$PHP_BIN" artisan atlas:runtime workspace.profile "$@" --workspace="$CALLER_PWD"
    ;;
  start|focus|work)
    shift || true
    exec_artisan_with_workspace atlas:cli:start "$@"
    ;;
  worker|daemon)
    shift || true
    exec "$PHP_BIN" artisan atlas:ai:work "$@"
    ;;
  health)
    shift || true
    exec "$PHP_BIN" artisan atlas:ai:health "$@"
    ;;
  providers)
    shift || true
    exec "$PHP_BIN" artisan atlas:cli:providers "$@"
    ;;
  setup|init)
    shift || true
    exec "$PHP_BIN" artisan atlas:cli:setup "$@"
    ;;
  bootstrap|configure)
    shift || true
    exec_artisan_with_workspace atlas:cli:bootstrap "$@"
    ;;
  version)
    shift || true
    exec "$PHP_BIN" artisan atlas:cli:version "$@"
    ;;
  update)
    shift || true
    exec "$PHP_BIN" artisan atlas:cli:update "$@"
    ;;
  rollback)
    shift || true
    exec "$PHP_BIN" artisan atlas:cli:rollback "$@"
    ;;
  install)
    shift || true
    exec "$PHP_BIN" artisan atlas:cli:install "$@"
    ;;
  provider-health)
    shift || true
    exec "$PHP_BIN" artisan atlas:ai:health "$@"
    ;;
  doctor)
    shift || true
    exec_artisan_with_workspace atlas:cli:doctor "$@"
    ;;
  final|readiness|product)
    shift || true
    exec_artisan_with_workspace atlas:cli:final "$@"
    ;;
  dogfood)
    shift || true
    exec_artisan_with_workspace atlas:cli:dogfood "$@"
    ;;
  release)
    shift || true
    release_args=()
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --version=*)
          release_args+=("--release-version=${1#--version=}")
          ;;
        --version)
          shift || true
          release_args+=("--release-version=${1:-}")
          ;;
        *)
          release_args+=("$1")
          ;;
      esac
      shift || true
    done
    if has_workspace_arg "${release_args[@]}"; then
      exec "$PHP_BIN" artisan atlas:cli:release "${release_args[@]}"
    fi
    exec "$PHP_BIN" artisan atlas:cli:release "${release_args[@]}" --workspace="$CALLER_PWD"
    ;;
  ai-doctor)
    shift || true
    exec "$PHP_BIN" artisan atlas:ai:doctor "$@"
    ;;
  bootstrap-skills)
    shift || true
    exec "$PHP_BIN" artisan atlas:ai:bootstrap-skills "$@"
    ;;
  *)
    exec "$PHP_BIN" artisan atlas:ai:chat "$(join_input "$@")" --stream --workspace="$CALLER_PWD"
    ;;
esac
